@startuml block-diagram
!theme plain
skinparam backgroundColor white
skinparam componentStyle rectangle
skinparam defaultFontName Helvetica
skinparam shadowing false
skinparam roundcorner 8
skinparam component {
  BackgroundColor #F4F1EA
  BorderColor #6B5B3E
  ArrowColor #6B5B3E
}
skinparam package {
  BackgroundColor #FBFAF7
  BorderColor #A89E8C
}

title Firmware architecture — module + task split (ESP32-P4, dual-core)

package "setup() — synchronous, before the split" as Setup {
  [provisioning.{h,cpp}\n(AP + setup web server —\nowns LVGL directly, can't\nrun concurrently with uiTask)] as Provisioning
}

package "Core 0 — uiTaskFn" as UICore {
  [display.{h,cpp}\n(LVGL/M5GFX init, flush + touch cbs, pumpLvgl)] as Display
  [boot_ui.{h,cpp}\n(status screen, wifi-error text)] as BootUi
  [dashboard UI\n(not built yet)] as Dashboard
  BootUi --> Display
  Dashboard --> Display
}

package "Shared state" as Shared {
  [SharedState\n(mutex-protected Status)] as SharedState
}

package "Core 1 — netTaskFn" as NetCore {
  [config_store.{h,cpp}\n(NVS-backed settings)] as ConfigStore
  [http_json_client.{h,cpp}\n(shared GET+dechunk+parse)] as HttpClient
  [json_arena_allocator.h\n(stack-backed JsonDocument)] as JsonArena
  [geocode.{h,cpp}] as Geocode
  [weather.{h,cpp}\n(current/hourly/daily)] as Weather

  Geocode --> ConfigStore
  Weather --> ConfigStore
  Geocode --> HttpClient
  Weather --> HttpClient
  Geocode --> JsonArena
  Weather --> JsonArena
}

[main.cpp\n(setup(): init display, run\nprovisioning if needed, create\nthe two tasks, self-delete)] as Main

Main --> Setup : runs first,\nif unprovisioned
Main --> UICore : xTaskCreatePinnedToCore(core 0)
Main --> NetCore : xTaskCreatePinnedToCore(core 1)
NetCore --> SharedState : publishStatus()
SharedState --> UICore : tryConsumeStatus()\neach LVGL tick

note bottom of NetCore
  Owns everything that blocks:
  WiFi connect, geocoding,
  weather fetches. Free to
  block — off the render path.
end note

note bottom of UICore
  Never blocks on network I/O.
  Renders whatever SharedState
  last published.
end note

@enduml
