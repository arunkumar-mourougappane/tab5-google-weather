@startuml class-diagram
!theme plain
skinparam backgroundColor white
skinparam defaultFontName Helvetica
skinparam shadowing false
skinparam roundcorner 6
skinparam class {
  BackgroundColor #F4F1EA
  BorderColor #6B5B3E
  ArrowColor #6B5B3E
}
skinparam stereotypeCBackgroundColor #D99A4E

title Module classes

class Main <<setup(), before the split>> {
  + setup()
}

class NetTaskFn <<FreeRTOS task, core 1>> {
  + run()
}

class UiTaskFn <<FreeRTOS task, core 0>> {
  + run()
}

class ConfigStore {
  + begin()
  + isProvisioned() : bool
  + wifiSsid() : String
  + wifiPassword() : String
  + locationQuery() : String
  + apiKey() : String
  + unitsImperial() : bool
  + hasLocation() : bool
  + latitude() : float
  + longitude() : float
  + saveProvisioning(ssid, password, locationQuery, apiKey, unitsImperial)
  + saveLocation(lat, lon)
  + reset()
}

class ProvisioningServer <<free functions>> {
  + runProvisioning(config : ConfigStore&)
}

class "HttpJsonClient" as HttpJsonClient <<free functions>> {
  + httpGetJson(http, client, url, doc : JsonDocument&, outHttpCode, outBody) : bool
}

class "JsonArenaAllocator" as JsonArena {
  + allocate(size) : void*
  + deallocate(ptr)
  + reallocate(ptr, newSize) : void*
  + overflowed() : bool
  + bytesUsed() : size_t
}

class "StackJsonDocument<N>" as StackJsonDocument {
  + doc() : JsonDocument&
  + overflowed() : bool
  + bytesUsed() : size_t
}
StackJsonDocument *-- JsonArena

class GeocodeClient <<free functions>> {
  + geocodeLocation(query, apiKey, outLat, outLon, outError, outRetryable) : bool
}

class WeatherClient <<free functions>> {
  + fetchCurrentConditions(apiKey, lat, lon, unitsImperial, out, outError, outRetryable) : bool
  + fetchHourlyForecast(..., out[8], outCount, outError, outRetryable) : bool
  + fetchDailyForecast(..., out[7], outCount, outError, outRetryable) : bool
  - appendDailyPoints(days, out, outCount)
  - sharedClient() : WiFiClientSecure&
}

class CurrentConditions <<struct>> {
  temperature : float
  feelsLikeTemperature : float
  relativeHumidity : int
  condition : WeatherCondition
  ...
}

class HourlyForecastPoint <<struct>> {
  displayDateTime : String
  temperature : float
  condition : WeatherCondition
}

class DailyForecastPoint <<struct>> {
  displayDate : String
  maxTemperature : float
  minTemperature : float
  daytimeCondition : WeatherCondition
}

class "SharedState" as SharedState <<mutex-protected>> {
  - mutex_ : SemaphoreHandle_t
  - status_ : Status
  - dirty_ : bool
  + publishStatus(title, subtitle, loading)
  + tryConsumeStatus(out) : bool
}

class "DisplayManager" as DisplayManager {
  + initDisplay()
  + pumpLvgl()
  - lvglFlushCb()
  - lvglTouchReadCb()
}

class "BootUi" as BootUi {
  + showStatusScreen(title, subtitle, loading)
  + describeWifiStatus(status) : const char*
}

Main --> ProvisioningServer : first boot only,\nsynchronous (owns LVGL\ndirectly - can't run\nalongside uiTaskFn)
Main --> DisplayManager : initDisplay()
Main --> NetTaskFn : xTaskCreatePinnedToCore(core 1)
Main --> UiTaskFn : xTaskCreatePinnedToCore(core 0)
ProvisioningServer --> ConfigStore : saveProvisioning()

NetTaskFn --> ConfigStore : read/write settings
NetTaskFn --> GeocodeClient : resolve location once
NetTaskFn --> WeatherClient : fetch once (no\nrefresh loop yet)
NetTaskFn --> SharedState : publishStatus()

GeocodeClient --> HttpJsonClient : uses
WeatherClient --> HttpJsonClient : uses
GeocodeClient --> StackJsonDocument : parses into
WeatherClient --> StackJsonDocument : parses into
WeatherClient ..> CurrentConditions : fills
WeatherClient ..> HourlyForecastPoint : fills
WeatherClient ..> DailyForecastPoint : fills

UiTaskFn --> DisplayManager : owns LVGL/touch
UiTaskFn --> BootUi : renders boot/status screens
UiTaskFn --> SharedState : tryConsumeStatus()

@enduml
